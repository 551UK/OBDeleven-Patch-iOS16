<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>items</key>
    <array>
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>footerText</key>
            <string>The selected version now controls the whole working bypass. It is used for CFBundleShortVersionString and x-mobile-app-version, while the known-working CFBundleVersion spoof is applied only when spoofing is active. Setting this back to the app's real 1.11.0 disables every spoof so the Update Required screen can return.</string>
            <key>label</key>
            <string>OBDeleven Update Bypass</string>
        </dict>

        <dict>
            <key>cell</key>
            <string>PSSwitchCell</string>
            <key>default</key>
            <true/>
            <key>getter</key>
            <string>readPreferenceValue:</string>
            <key>key</key>
            <string>enabled</string>
            <key>label</key>
            <string>Enabled</string>
            <key>setter</key>
            <string>setPreferenceValue:specifier:</string>
        </dict>

        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>footerText</key>
            <string>Default: 2.10.0. Change this when OBDeleven starts requiring a newer app version. Fully close and reopen OBDeleven after changing it. Setting it to 1.11.0 turns the runtime spoof off completely.</string>
            <key>label</key>
            <string>Version Spoof</string>
        </dict>

        <dict>
            <key>cell</key>
            <string>PSEditTextCell</string>
            <key>default</key>
            <string>2.10.0</string>
            <key>getter</key>
            <string>readPreferenceValue:</string>
            <key>key</key>
            <string>spoofedVersion</string>
            <key>label</key>
            <string>Spoofed Version</string>
            <key>placeholder</key>
            <string>2.10.0</string>
            <key>setter</key>
            <string>setPreferenceValue:specifier:</string>
        </dict>

        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>footerText</key>
            <string>Reset restores the known-working 2.10.0 spoof. Respring applies the preference state system-wide; you should still fully close OBDeleven before testing its startup update check.</string>
        </dict>

        <dict>
            <key>action</key>
            <string>resetWorkingDefaults</string>
            <key>cell</key>
            <string>PSButtonCell</string>
            <key>label</key>
            <string>Reset Working Default</string>
        </dict>

        <dict>
            <key>action</key>
            <string>respring</string>
            <key>cell</key>
            <string>PSButtonCell</string>
            <key>label</key>
            <string>Respring</string>
        </dict>

        <dict>
            <key>action</key>
            <string>openGitHub</string>
            <key>cell</key>
            <string>PSButtonCell</string>
            <key>label</key>
            <string>GitHub Repository</string>
        </dict>
    </array>

    <key>title</key>
    <string>OBDeleven Update Bypass</string>
</dict>
</plist>
