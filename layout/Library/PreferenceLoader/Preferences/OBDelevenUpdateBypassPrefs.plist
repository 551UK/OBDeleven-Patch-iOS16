<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>title</key>
    <string>OBDeleven Update Bypass</string>

    <key>entry</key>
    <dict>
        <key>cell</key>
        <string>PSLinkCell</string>
        <key>label</key>
        <string>OBDeleven Update Bypass</string>
        <key>icon</key>
        <string>OBDelevenUpdateBypass.png</string>
    </dict>

    <key>items</key>
    <array>
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>Version Spoof</string>
            <key>footerText</key>
            <string>Change this only when OBDeleven starts requiring a newer app version. The value is used for both the app version spoof and the x-mobile-app-version network header.</string>
        </dict>

        <dict>
            <key>cell</key>
            <string>PSEditTextCell</string>
            <key>label</key>
            <string>Spoofed Version</string>
            <key>defaults</key>
            <string>com.551.obdelevenupdatebypass</string>
            <key>key</key>
            <string>spoofedVersion</string>
            <key>default</key>
            <string>2.10.0</string>
            <key>PostNotification</key>
            <string>com.551.obdelevenupdatebypass/preferences.changed</string>
        </dict>

        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>footerText</key>
            <string>Default: 2.10.0. Fully close and reopen OBDeleven after changing the version.</string>
        </dict>
    </array>
</dict>
</plist>
