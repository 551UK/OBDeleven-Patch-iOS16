<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Injects the runtime bypass only into the regular OBDeleven and OBDeleven VAG apps. -->
<plist version="1.0">
<dict>
	<key>Filter</key>
	<dict>
		<key>Bundles</key>
		<array>
			<string>com.voltasit.obdeleven.ios.basic</string>
			<string>com.voltasit.obdeleven.ios</string>
		</array>
	</dict>
</dict>
</plist>
